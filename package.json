{
  "name": "nyaterm-bridge",
  "version": "0.1.0",
  "description": "Run AI commands inside NyaTerm terminal sessions, reusing the connections, groups and jump hosts already configured there, with a per-workspace allowlist. Commands stay visible in NyaTerm and can be recorded for audit. The allowlist and the NyaTerm MCP helper location are edited in Settings → NyaTerm 白名单.",
  "license": "MIT",
  "author": "visualcjy",
  "homepage": "https://github.com/visualcjy/nyaterm-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visualcjy/nyaterm-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/visualcjy/nyaterm-bridge/issues"
  },
  "icon": "assets/icon.png",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "nyaterm",
    "terminal",
    "mcp"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/icon.png",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  }
}
